# Build artifacts. Source-owned Wails inputs are explicitly exposed below:
# the master icon, macOS plists, Linux package metadata, and Windows
# resource/NSIS templates. Compiled binaries, packages, derived icons,
# wails_tools.nsh, and the WebView bootstrapper remain generated output.
/build/*
!/build/appicon.png
!/build/darwin/
/build/darwin/*
!/build/darwin/Info.plist
!/build/darwin/Info.dev.plist
!/build/linux/
/build/linux/*
!/build/linux/gopmgr.desktop
!/build/linux/nfpm.yaml
!/build/windows/
/build/windows/*
!/build/windows/info.json
!/build/windows/wails.exe.manifest
!/build/windows/installer/
/build/windows/installer/*
!/build/windows/installer/project.nsi
/bin/
*.exe
*.dll
*.so
*.dylib
/gopmgr
/gopmgr-*
/GoPMgr/
# Branding masters and platform exports are tracked under assets/branding and
# frontend/public/branding. Root SVG branding has been retired intentionally.

# Wails generated bindings
/frontend/wailsjs/

# Stale pre-relocation embed copy (main package moved from cmd/pmforge to root)
/cmd/

# Node
# Root Vite/Vitest invocations can create generated caches here.
/node_modules/
/frontend/node_modules/
/frontend/dist/
/frontend/.svelte-kit/
/frontend/coverage/
frontend/package.json.md5

# Local validation scratch space
/.tmp/

# Local agent handoff and execution plans. These can contain machine-specific
# paths, dirty-worktree notes, and private planning context.
/session-notes.md
/docs/superpowers/plans/

# Local release-readiness evidence (screenshots, packaged-app test notes).
# Contains machine-specific paths; see beta-release-backlog.md's "must link
# to current tests or an archived release artifact" rule -- a gitignored
# path here does not satisfy that for another clone, and backlog rows
# referencing it must say so explicitly rather than link it as if it were a
# tracked repo artifact.
/docs/release-evidence/

# Superseded root agent-instruction duplicates; keep public guidance in AGENTS.md.
/CLAUDE.md
/GO_CODER_AGENTS.md

# Go
*.test
*.out
coverage.txt

# Project data (don't commit user data)
*.pmforge
*.pmforge-wal
*.pmforge-shm
*.pmba
*.bak
temp_snapshot.db

# Downloaded/generated binary inputs
/internal/fonts/assets/*.ttf
!/internal/fonts/assets/SourceSans3-Regular.ttf
!/internal/fonts/assets/SourceSans3-Bold.ttf
!/internal/fonts/assets/SourceSans3-It.ttf
!/internal/fonts/assets/SourceSans3-BoldIt.ttf
/GoPMgr Icon Image *.png
/GoPMgr Logo Image *.png
/GoPMgr App Icon (square-style, no text).png
/Full GoPMgr Dark Logo (gopher + text).png
/Full GoPMgr Light Logo (gopher + text).png
*.zip

# Certificates (NEVER commit private keys)
*.p12
*.pfx
*.key
*.pem
# Exception: test-only, self-signed PKCS#12 fixtures for internal/crypto's
# LoadCertificate tests. These sign nothing real -- see the testdata README.
!internal/crypto/testdata/testonly-*.p12
!LICENSES/*.txt

# Agent memory (local-only; not for public consumption)
/.agent_memory/

# Claude Code project directory (machine-specific state, local settings,
# worktrees, session data). Not for public consumption.
/.claude/

# OS / editor
.DS_Store
Thumbs.db
~$*.docx
.idea/
.vscode/
*.swp
*~
