{
  "name": "gopmgr-frontend",
  "version": "1.1.0",
  "description": "GoPMgr Svelte 5 frontend.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --ext .ts,.svelte src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.all --coverage.include='src/**/*.{ts,svelte}'",
    "test:bug-report-regressions": "node scripts/bug-report-regression-check.mjs",
    "test:project-settings-encryption": "node scripts/project-settings-encryption-check.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.6",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
