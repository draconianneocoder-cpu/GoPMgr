#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 James L. Burns and The GoPMgr Contributors
# SPDX-License-Identifier: GPL-3.0-or-later

export CGO_ENABLED := 1

%:
	dh $@

# The vendored tree must not carry the excluded TPC-H/TPC-DS archives
# (docs/review/TPC-benchmark-exclusion-decision.md); `go mod vendor` copies
# them, so a plain vendored source package fails here by design.
override_dh_auto_build:
	bash scripts/verify-excluded-native-code.sh --tree vendor
	go build -buildmode=pie -buildvcs=false -mod=vendor -trimpath -tags "desktop,production,duckdb,webkit2_41" -ldflags "-s -w" -o build/ppa/gopmgr .

override_dh_auto_install:
	install -D -m 0755 build/ppa/gopmgr debian/gopmgr/usr/bin/gopmgr
	install -D -m 0644 build/linux/gopmgr.desktop debian/gopmgr/usr/share/applications/gopmgr.desktop
	install -D -m 0644 build/appicon.png debian/gopmgr/usr/share/pixmaps/gopmgr.png
	install -D -m 0644 third_party/go-sqlcipher/THIRD_PARTY_NOTICES.txt debian/gopmgr/usr/share/doc/gopmgr/sqlcipher-license.txt
	bash scripts/verify-module-notices.sh build/ppa/gopmgr
	install -D -m 0644 third_party/GO-MODULE-NOTICES.txt debian/gopmgr/usr/share/doc/gopmgr/go-module-notices.txt
	install -D -m 0644 internal/fonts/assets/FONT-NOTICES.txt debian/gopmgr/usr/share/doc/gopmgr/font-notices.txt
	install -D -m 0644 third_party/DUCKDB-NATIVE-NOTICES.txt debian/gopmgr/usr/share/doc/gopmgr/duckdb-native-notices.txt

override_dh_auto_clean:
	rm -rf build/ppa
